{% apply spaceless %}

{# -- General global variables -- #}
{% set element = (category ?? entry ?? null) %}
{% set lang = currentSite.language[:2] %}

{# -- Site and language variables -- #}
{% set siteHandle = currentSite.handle %}
{% set siteId = currentSite.id %}
{% set siteUrl = currentSite.baseUrl %}
{% set siteLang = currentSite.language %}
{% set artifactBaseUrl = (getenv('PRIMARY_SITE_URL') ?: siteUrl)|trim('/') %}
{% set buildBaseUrl = artifactBaseUrl ~ '/build' %}

{# -- RTL detection (Arabic, Hebrew, Farsi, Urdu) -- #}
{% set rtlLanguages = ['ar', 'he', 'fa', 'ur'] %}
{% set isRtl = siteLang[:2] in rtlLanguages %}

{# -- Site name from env (pattern: PRIMARY_SITE_NAME_{HANDLE|upper}) -- #}
{% set siteName = getenv('PRIMARY_SITE_NAME_' ~ siteHandle|upper) ?: getenv('SYSTEM_NAME') ?: currentSite.name %}

{# -- Multi-site: all sites and other sites for language switcher -- #}
{% set allSites = app('CraftCms\\Cms\\Site\\Sites').allSites %}
{% set otherSites = allSites|filter(s => s.id != currentSite.id) %}

{# -- URL segments -- #}
{% set segments = app('request').segments %}
{% set fullPath = segments|join('/') %}

{# -- Environment detection -- #}
{% set environment = getenv('CRAFT_ENVIRONMENT') %}
{% set isDev = environment == 'dev' %}
{% set isStaging = environment == 'staging' %}
{% set isProduction = environment == 'production' %}

{# -- Navigation queries (centralized for performance) -- #}
{% set mainMenuNodes = [] %}
{% set footerNav = [] %}
{% if plugin('navigation') %}
	{% set mainMenuNodes = craft.navigation.nodes('main').level(1).all() ?? [] %}
	{% set footerNav = craft.navigation.nodes('footer').level(1).with(['children']).all() ?? [] %}
{% endif %}

{% set primaryTranslationCategory = getenv('PRIMARY_TRANSLATION_CATEGORY') ?: 'site' %}
{% set formTranslationCategory = 'formie' %}

{%
	set _globals = {
		site: {
			name: siteName,
			handle: siteHandle,
			lang: siteLang,
			isRtl: isRtl,
			url: siteUrl,
			allSites: allSites,
			otherSites: otherSites,
		},
		env: {
			isDev: isDev,
			isStaging: isStaging,
			isProduction: isProduction,
		},
		assets: {
			artifactBaseUrl: artifactBaseUrl,
			buildBaseUrl: buildBaseUrl,
		},
		nav: {
			main: mainMenuNodes,
			footer: footerNav,
		},
		translation: {
			primary: primaryTranslationCategory,
		},
		breadcrumbDefaults: {
			hideBreadcrumbs: false,
		},
	}
%}

{% endapply %}
{% block htmlPage %}{% endblock %}
