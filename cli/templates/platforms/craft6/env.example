# -----------------------------------------------------------------------------
# Craft CMS 6 experimental environment template
# -----------------------------------------------------------------------------

# Laravel application
APP_NAME=""
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Craft configuration
CRAFT_ENVIRONMENT=dev
CRAFT_DEV_MODE=true
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_ALLOW_UPDATES=true
CRAFT_DISALLOW_ROBOTS=true
CRAFT_TIMEZONE=UTC
CRAFT_CP_TRIGGER=cms
CRAFT_IS_SYSTEM_LIVE=true
CRAFT_RUN_QUEUE_AUTOMATICALLY=true

# System Settings
SYSTEM_NAME=""

# Database
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db
DB_SEARCH_PATH=
DB_PREFIX=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

# Site URLs
PRIMARY_SITE_URL=
PRIMARY_SITE_LANGUAGE=en
PRIMARY_TRANSLATION_CATEGORY=site

# English Site
PRIMARY_SITE_URL_EN=
PRIMARY_SITE_NAME_EN=""
PRIMARY_SITE_LABEL_EN=En

# Email
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=""

# Email - Postmark
POSTMARK_TOKEN=

# Email - SMTP
# Provider credentials replace the MAIL_* values above.

# Testing
CRAFT_TEST_TO_EMAIL_ADDRESS=
