{# -- Basic meta tags -- #}
<meta charset='UTF-8'>
<meta name='viewport' content='width=device-width, initial-scale=1.0, viewport-fit=cover'>

{# -- PWA iOS meta tags -- #}
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

{# -- Favicons -- #}
{% set faviconBase = _globals.assets.buildBaseUrl ~ '/assets/brand/favicons' %}
<link rel="icon" href="{{ faviconBase }}/favicon.ico">
<link rel="icon" type="image/svg+xml" sizes="any" href="{{ faviconBase }}/favicon.svg">
<link rel="apple-touch-icon" sizes="180x180" href="{{ faviconBase }}/apple-touch-icon.png">
<link rel="mask-icon" href="{{ faviconBase }}/safari-pinned-tab.svg" color="#1a1a1a">
<link rel="manifest" href="{{ faviconBase }}/{{ siteHandle }}/site.webmanifest">
